{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["electron/**/*", "src/shared/**/*.ts"],
  "exclude": [
    "electron/**/__tests__/**",
    "src/shared/sessionNavigator/presentation.ts",
    "src/shared/sessionNavigator/**/*.tsx",
    "src/shared/sessionNavigator/css.d.ts"
  ]
}
